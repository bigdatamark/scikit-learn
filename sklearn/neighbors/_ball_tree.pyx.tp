#----------------------------------------------------------------------
# The functions below specialized the Binary Tree as a Ball Tree
#
#   Note that these functions use the concept of "reduced distance".
#   The reduced distance, defined for some metrics, is a quantity which
#   is more efficient to compute than the distance, but preserves the
#   relative rankings of the true distance.  For example, the reduced
#   distance for the Euclidean metric is the squared-euclidean distance.
#   For some metrics, the reduced distance is simply the distance.

{{for name_suffix, INPUT_DTYPE_t, INPUT_DTYPE in implementation_specific_values}}

cdef int allocate_data{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t n_nodes,
    intp_t n_features,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: allocates tree.node_bounds as zeros of shape
    # (1, n_nodes, n_features) in the input dtype; slot 0 holds node centroids.
    # Inputs: tree, n_nodes, n_features. Outputs: returns 0.
    # Exceptions: MemoryError from NumPy; -1 error return.
    # Side effects: replaces tree.node_bounds.
    # KNOWN ISSUE: the docstring says "KD Tree" but this is the Ball Tree hook.
    """Allocate arrays needed for the KD Tree"""
    tree.node_bounds = np.zeros((1, n_nodes, n_features), dtype={{INPUT_DTYPE}})
    return 0


cdef int init_node{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    NodeData_t[::1] node_data,
    intp_t i_node,
    intp_t idx_start,
    intp_t idx_end,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: computes the node centroid as the mean of its points
    # (idx_array[idx_start:idx_end]), weighted by sample_weight when present,
    # then the radius as the maximum reduced distance from the centroid to the
    # points, converted to a true distance with the metric. Stores the centroid in
    # node_bounds[0, i_node] and radius, idx_start, idx_end in node_data[i_node]
    # (is_leaf is set by the caller).
    # Inputs: tree (data, idx_array, node_bounds allocated), node_data view,
    # i_node, idx_start < idx_end range in idx_array.
    # Outputs: returns 0; writes node_bounds and node_data.
    # Exceptions: errors from the metric (-1 return). A zero total sample weight
    # in a node would divide by zero.
    # Side effects: mutates tree.node_bounds and node_data.
    """Initialize the node for the dataset stored in tree.data"""
    cdef intp_t n_features = tree.data.shape[1]
    cdef intp_t n_points = idx_end - idx_start

    cdef intp_t i, j
    cdef float64_t radius
    cdef const {{INPUT_DTYPE_t}} *this_pt

    cdef const intp_t* idx_array = &tree.idx_array[0]
    cdef const {{INPUT_DTYPE_t}}* data = &tree.data[0, 0]
    cdef {{INPUT_DTYPE_t}}* centroid = &tree.node_bounds[0, i_node, 0]

    cdef bint with_sample_weight = tree.sample_weight is not None
    cdef const {{INPUT_DTYPE_t}}* sample_weight
    cdef float64_t sum_weight_node
    if with_sample_weight:
        sample_weight = &tree.sample_weight[0]

    # determine Node centroid
    for j in range(n_features):
        centroid[j] = 0

    if with_sample_weight:
        sum_weight_node = 0
        for i in range(idx_start, idx_end):
            sum_weight_node += sample_weight[idx_array[i]]
            this_pt = data + n_features * idx_array[i]
            for j from 0 <= j < n_features:
                centroid[j] += this_pt[j] * sample_weight[idx_array[i]]

        for j in range(n_features):
            centroid[j] /= sum_weight_node
    else:
        for i in range(idx_start, idx_end):
            this_pt = data + n_features * idx_array[i]
            for j from 0 <= j < n_features:
                centroid[j] += this_pt[j]

        for j in range(n_features):
            centroid[j] /= n_points

    # determine Node radius
    radius = 0
    for i in range(idx_start, idx_end):
        radius = fmax(radius,
                      tree.rdist(centroid,
                                 data + n_features * idx_array[i],
                                 n_features))

    node_data[i_node].radius = tree.dist_metric._rdist_to_dist(radius)
    node_data[i_node].idx_start = idx_start
    node_data[i_node].idx_end = idx_end
    return 0


cdef inline float64_t min_dist{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t i_node,
    const {{INPUT_DTYPE_t}}* pt,
) except -1 nogil:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: lower bound on the distance from pt to any point in node
    # i_node: distance to the centroid minus radius, clipped at 0.
    # Inputs: tree, i_node, pt (n_features values). Outputs: distance.
    # Exceptions: metric errors (-1). Side effects: none; nogil.
    """Compute the minimum distance between a point and a node"""
    cdef float64_t dist_pt = tree.dist(pt, &tree.node_bounds[0, i_node, 0],
                                     tree.data.shape[1])
    return fmax(0, dist_pt - tree.node_data[i_node].radius)


cdef inline float64_t max_dist{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t i_node,
    const {{INPUT_DTYPE_t}}* pt,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: upper bound on the distance from pt to any point in the node:
    # distance to the centroid plus radius.
    # Inputs: tree, i_node, pt. Outputs: distance.
    # Exceptions: metric errors (-1). Side effects: none; requires the GIL.
    """Compute the maximum distance between a point and a node"""
    cdef float64_t dist_pt = tree.dist(pt, &tree.node_bounds[0, i_node, 0],
                                     tree.data.shape[1])
    return dist_pt + tree.node_data[i_node].radius


cdef inline int min_max_dist{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t i_node,
    const {{INPUT_DTYPE_t}}* pt,
    float64_t* min_dist,
    float64_t* max_dist,
) except -1 nogil:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: computes both bounds of min_dist and max_dist with a single
    # centroid distance evaluation.
    # Inputs: tree, i_node, pt; min_dist, max_dist output pointers.
    # Outputs: returns 0; writes min_dist[0] and max_dist[0].
    # Exceptions: metric errors (-1). Side effects: writes outputs; nogil.
    """Compute the minimum and maximum distance between a point and a node"""
    cdef float64_t dist_pt = tree.dist(pt, &tree.node_bounds[0, i_node, 0],
                                     tree.data.shape[1])
    cdef float64_t rad = tree.node_data[i_node].radius
    min_dist[0] = fmax(0, dist_pt - rad)
    max_dist[0] = dist_pt + rad
    return 0


cdef inline float64_t min_rdist{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t i_node,
    const {{INPUT_DTYPE_t}}* pt,
) except -1 nogil:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: min_dist converted to reduced distance (squared for the
    # euclidean fast path, otherwise via the metric's dist-to-rdist conversion).
    # Inputs: tree, i_node, pt. Outputs: reduced distance lower bound.
    # Exceptions: metric errors (-1). Side effects: none; nogil.
    """Compute the minimum reduced-distance between a point and a node"""
    if tree.euclidean:
        return euclidean_dist_to_rdist{{name_suffix}}(
            min_dist{{name_suffix}}(tree, i_node, pt)
        )
    else:
        return tree.dist_metric._dist_to_rdist(
            min_dist{{name_suffix}}(tree, i_node, pt)
        )


cdef inline float64_t max_rdist{{name_suffix}}(
    BinaryTree{{name_suffix}} tree,
    intp_t i_node,
    const {{INPUT_DTYPE_t}}* pt,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: max_dist converted to reduced distance (as in min_rdist).
    # Inputs: tree, i_node, pt. Outputs: reduced distance upper bound.
    # Exceptions: metric errors (-1). Side effects: none.
    """Compute the maximum reduced-distance between a point and a node"""
    if tree.euclidean:
        return euclidean_dist_to_rdist{{name_suffix}}(
            max_dist{{name_suffix}}(tree, i_node, pt)
        )
    else:
        return tree.dist_metric._dist_to_rdist(
            max_dist{{name_suffix}}(tree, i_node, pt)
        )


cdef inline float64_t min_dist_dual{{name_suffix}}(
    BinaryTree{{name_suffix}} tree1,
    intp_t i_node1,
    BinaryTree{{name_suffix}} tree2,
    intp_t i_node2,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: lower bound on the distance between any point of node i_node1
    # of tree1 and any point of node i_node2 of tree2: centroid distance minus
    # both radii, clipped at 0. Uses tree1's metric.
    # Inputs: tree1, i_node1, tree2, i_node2 (same n_features).
    # Outputs: distance. Exceptions: metric errors (-1). Side effects: none.
    """compute the minimum distance between two nodes"""
    cdef float64_t dist_pt = tree1.dist(&tree2.node_bounds[0, i_node2, 0],
                                      &tree1.node_bounds[0, i_node1, 0],
                                      tree1.data.shape[1])
    return fmax(0, (dist_pt - tree1.node_data[i_node1].radius
                    - tree2.node_data[i_node2].radius))


cdef inline float64_t max_dist_dual{{name_suffix}}(
    BinaryTree{{name_suffix}} tree1,
    intp_t i_node1,
    BinaryTree{{name_suffix}} tree2,
    intp_t i_node2,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: upper bound on the distance between points of the two nodes:
    # centroid distance plus both radii.
    # Inputs: tree1, i_node1, tree2, i_node2. Outputs: distance.
    # Exceptions: metric errors (-1). Side effects: none.
    """compute the maximum distance between two nodes"""
    cdef float64_t dist_pt = tree1.dist(&tree2.node_bounds[0, i_node2, 0],
                                      &tree1.node_bounds[0, i_node1, 0],
                                      tree1.data.shape[1])
    return (dist_pt + tree1.node_data[i_node1].radius
            + tree2.node_data[i_node2].radius)


cdef inline float64_t min_rdist_dual{{name_suffix}}(
    BinaryTree{{name_suffix}} tree1,
    intp_t i_node1,
    BinaryTree{{name_suffix}} tree2,
    intp_t i_node2,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: min_dist_dual converted to reduced distance with tree1's metric.
    # Inputs: tree1, i_node1, tree2, i_node2. Outputs: reduced distance.
    # Exceptions: metric errors (-1). Side effects: none.
    """compute the minimum reduced distance between two nodes"""
    if tree1.euclidean:
        return euclidean_dist_to_rdist{{name_suffix}}(
            min_dist_dual{{name_suffix}}(tree1, i_node1, tree2, i_node2)
        )
    else:
        return tree1.dist_metric._dist_to_rdist(
            min_dist_dual{{name_suffix}}(tree1, i_node1, tree2, i_node2)
        )


cdef inline float64_t max_rdist_dual{{name_suffix}}(
    BinaryTree{{name_suffix}} tree1,
    intp_t i_node1,
    BinaryTree{{name_suffix}} tree2,
    intp_t i_node2,
) except -1:
    # [FUNCTION DOC]
    # Template, instantiated per dtype suffix.
    # Behavior: max_dist_dual converted to reduced distance with tree1's metric.
    # Inputs: tree1, i_node1, tree2, i_node2. Outputs: reduced distance.
    # Exceptions: metric errors (-1). Side effects: none.
    """compute the maximum reduced distance between two nodes"""
    if tree1.euclidean:
        return euclidean_dist_to_rdist{{name_suffix}}(
            max_dist_dual{{name_suffix}}(tree1, i_node1, tree2, i_node2)
        )
    else:
        return tree1.dist_metric._dist_to_rdist(
            max_dist_dual{{name_suffix}}(tree1, i_node1, tree2, i_node2)
        )

{{endfor}}


class BallTree(BallTree64):
    # [CLASS DOC]
    # Public BallTree: the float64 instantiation with the generic docstring.
    __doc__ = CLASS_DOC.format(BinaryTree="BallTree")
    pass
