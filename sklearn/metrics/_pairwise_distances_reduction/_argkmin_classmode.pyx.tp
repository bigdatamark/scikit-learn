# [MODULE DOC]
# ArgKminClassMode: a k-nearest-neighbors reduction that, instead of returning
# neighbor indices, directly accumulates per-class scores for each row of X
# from the labels of its k nearest rows of Y and returns normalized class
# probabilities (used by KNeighborsClassifier.predict_proba for brute force
# with uniform weights). It subclasses ArgKmin and replaces the final sorting
# by a histogram pass over each row's heap. Only the generic (DatasetsPair)
# distance path is used, no Euclidean GEMM specialization. Tempita template
# instantiated for suffixes 32 and 64 (input dtype).
from cython cimport floating, integral
from cython.parallel cimport parallel, prange
from libcpp.map cimport map as cpp_map, pair as cpp_pair
from libc.stdlib cimport free

from sklearn.utils._typedefs cimport intp_t, float64_t
from sklearn.utils.parallel import _get_threadpool_controller

import numpy as np
from scipy.sparse import issparse
from sklearn.metrics._pairwise_distances_reduction._classmode cimport WeightingStrategy

{{for name_suffix in ["32", "64"]}}
from sklearn.metrics._pairwise_distances_reduction._argkmin cimport ArgKmin{{name_suffix}}
from sklearn.metrics._pairwise_distances_reduction._datasets_pair cimport DatasetsPair{{name_suffix}}

cdef class ArgKminClassMode{{name_suffix}}(ArgKmin{{name_suffix}}):
    # [CLASS DOC]
    # ArgKmin subclass holding encoded labels of Y rows, the unique labels, a
    # float64 score matrix of shape (n_samples_X, n_classes) and the weighting
    # strategy. The declared label-to-index map is never used.
    """
    {{name_suffix}}bit implementation of ArgKminClassMode.
    """
    cdef:
        const intp_t[:] Y_labels,
        const intp_t[:] unique_Y_labels
        float64_t[:, :] class_scores
        cpp_map[intp_t, intp_t] labels_to_index
        WeightingStrategy weight_type

    @classmethod
    def compute(
        cls,
        X,
        Y,
        intp_t k,
        weights,
        Y_labels,
        unique_Y_labels,
        str metric="euclidean",
        chunk_size=None,
        dict metric_kwargs=None,
        str strategy=None,
    ):
        # [FUNCTION DOC]
        # Entry point class method.
        # Behavior: builds the instance on DatasetsPair.get_for(X, Y, metric,
        # metric_kwargs), runs the chosen strategy under a one-thread BLAS limit and
        # returns the class probabilities.
        # Inputs: X, Y (dense or CSR, suffix dtype); k; weights ("uniform" or
        # "distance"); Y_labels, intp label codes of Y rows in [0, n_classes);
        # unique_Y_labels (its length gives n_classes); metric; chunk_size;
        # metric_kwargs; strategy.
        # Outputs: float64 array of shape (n_samples_X, n_classes), rows summing to 1.
        # Exceptions: those of the constructors and input conversion.
        # Side effects: temporary threadpool limit; OpenMP parallelism.
        """Compute the argkmin reduction with Y_labels.

        This classmethod is responsible for introspecting the arguments
        values to dispatch to the most appropriate implementation of
        :class:`ArgKminClassMode{{name_suffix}}`.

        This allows decoupling the API entirely from the implementation details
        whilst maintaining RAII: all temporarily allocated datastructures necessary
        for the concrete implementation are therefore freed when this classmethod
        returns.

        No instance _must_ directly be created outside of this class method.
        """
        # Use a generic implementation that handles most scipy
        # metrics by computing the distances between 2 vectors at a time.
        pda = ArgKminClassMode{{name_suffix}}(
            datasets_pair=DatasetsPair{{name_suffix}}.get_for(X, Y, metric, metric_kwargs),
            k=k,
            chunk_size=chunk_size,
            strategy=strategy,
            weights=weights,
            Y_labels=Y_labels,
            unique_Y_labels=unique_Y_labels,
        )

        # Limit the number of threads in second level of nested parallelism for BLAS
        # to avoid threads over-subscription (in GEMM for instance).
        with _get_threadpool_controller().limit(limits=1, user_api="blas"):
            if pda.execute_in_parallel_on_Y:
                pda._parallel_on_Y()
            else:
                pda._parallel_on_X()

        return pda._finalize_results()

    def __init__(
        self,
        DatasetsPair{{name_suffix}} datasets_pair,
        const intp_t[:] Y_labels,
        const intp_t[:] unique_Y_labels,
        chunk_size=None,
        strategy=None,
        intp_t k=1,
        weights=None,
    ):
        # [FUNCTION DOC]
        # Behavior: ArgKmin initialization, maps weights to the enum ("uniform",
        # "distance", anything else becomes callable), stores labels and allocates a
        # zero score matrix of shape (n_samples_X, number of unique labels).
        # Exceptions: ArgKmin errors; buffer errors if labels are not intp arrays.
        super().__init__(
            datasets_pair=datasets_pair,
            chunk_size=chunk_size,
            strategy=strategy,
            k=k,
        )

        if weights == "uniform":
            self.weight_type = WeightingStrategy.uniform
        elif weights == "distance":
            self.weight_type = WeightingStrategy.distance
        else:
            self.weight_type = WeightingStrategy.callable
        self.Y_labels = Y_labels

        self.unique_Y_labels = unique_Y_labels

        cdef intp_t idx, neighbor_class_idx
        # Map from set of unique labels to their indices in `class_scores`
        # Buffer used in building a histogram for one-pass weighted mode
        self.class_scores = np.zeros(
            (self.n_samples_X, unique_Y_labels.shape[0]), dtype=np.float64,
        )

    def _finalize_results(self):
        # [FUNCTION DOC]
        # Normalizes each row of the score matrix by its sum, in place, and returns it
        # as a numpy array (a view on the internal buffer). Rows with all-zero scores
        # would produce NaN, but every row receives k positive votes in uniform mode.
        probabilities = np.asarray(self.class_scores)
        probabilities /= probabilities.sum(axis=1, keepdims=True)
        return probabilities

    cdef inline void weighted_histogram_mode(
        self,
        intp_t sample_index,
        intp_t* indices,
        float64_t* distances,
   ) noexcept nogil:
        # [FUNCTION DOC]
        # HELPER: per-row vote accumulation used by both strategy finalizers.
        # Behavior: for each of the k neighbors of X row sample_index, adds an increment
        # to the score of the neighbor's label code: 1, or the inverse of the stored
        # distance in distance mode.
        # Inputs: sample_index; indices and distances, pointers to that row's k heap
        # entries.
        # Outputs: class_scores row updated in place. Exceptions: none (nogil).
        # KNOWN ISSUE: distance weighting uses the stored surrogate distances (for
        # example squared euclidean distances) rather than exact distances, and a
        # zero distance gives an infinite score; estimators only call this reduction
        # with uniform weights, so the issue is latent.
        cdef:
            intp_t neighbor_idx, neighbor_class_idx, label_index, multi_output_index
            float64_t score_incr = 1
            # TODO: Implement other WeightingStrategy values
            bint use_distance_weighting = (
                self.weight_type == WeightingStrategy.distance
            )

        # Iterate through the sample k-nearest neighbours
        for neighbor_rank in range(self.k):
            # Absolute indice of the neighbor_rank-th Nearest Neighbors
            # in range [0, n_samples_Y)
            # TODO: inspect if it worth permuting this condition
            # and the for-loop above for improved branching.
            if use_distance_weighting:
                score_incr = 1 / distances[neighbor_rank]
            neighbor_idx = indices[neighbor_rank]
            neighbor_class_idx = self.Y_labels[neighbor_idx]
            self.class_scores[sample_index][neighbor_class_idx] += score_incr
        return

    cdef void _parallel_on_X_prange_iter_finalize(
        self,
        intp_t thread_num,
        intp_t X_start,
        intp_t X_end,
    ) noexcept nogil:
        # [FUNCTION DOC]
        # Parallel on X override (no sorting): after all Y chunks for X rows [X_start,
        # X_end), accumulates the votes of each row from the heap block of thread
        # thread_num (which points into the main ArgKmin results). nogil, noexcept.
        cdef:
            intp_t idx, sample_index
        for idx in range(X_end - X_start):
            # One-pass top-one weighted mode
            # Compute the absolute index in [0, n_samples_X)
            sample_index = X_start + idx
            self.weighted_histogram_mode(
                sample_index,
                &self.heaps_indices_chunks[thread_num][idx * self.k],
                &self.heaps_r_distances_chunks[thread_num][idx * self.k],
            )
        return

    cdef void _parallel_on_Y_finalize(
        self,
    ) noexcept nogil:
        # [FUNCTION DOC]
        # Parallel on Y override (no sorting): frees each thread's private heaps, then
        # accumulates the votes of every X row from the merged main heaps, both in
        # parallel OpenMP loops. nogil, noexcept. Side effects: frees memory.
        cdef:
            intp_t sample_index, thread_num

        with nogil, parallel(num_threads=self.chunks_n_threads):
            # Deallocating temporary datastructures
            for thread_num in prange(self.chunks_n_threads, schedule='static'):
                free(self.heaps_r_distances_chunks[thread_num])
                free(self.heaps_indices_chunks[thread_num])

            for sample_index in prange(self.n_samples_X, schedule='static'):
                self.weighted_histogram_mode(
                    sample_index,
                    &self.argkmin_indices[sample_index][0],
                    &self.argkmin_distances[sample_index][0],
                )
        return

{{endfor}}
