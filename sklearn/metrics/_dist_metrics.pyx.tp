#------------------------------------------------------------
# Haversine Distance (2 dimensional)
#  D(x, y) = 2 arcsin{sqrt[sin^2 ((x1 - y1) / 2)
#                          + cos(x1) cos(y1) sin^2 ((x2 - y2) / 2)]}
cdef class HaversineDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Haversine (great-circle angular) distance between 2-D points given as
    # [latitude, longitude] in radians: 2 arcsin(sqrt(sin^2(dlat/2) + cos(lat1) cos(lat2)
    # sin^2(dlon/2))). rdist is the term inside the square root (haversine of the angle).
    """Haversine (Spherical) Distance

    The Haversine distance is the angular distance between two points on
    the surface of a sphere.  The first distance of each point is assumed
    to be the latitude, the second is the longitude, given in radians.
    The dimension of the points must be 2:

    D(x, y) = 2 arcsin[sqrt{sin^2((x1 - y1) / 2) + cos(x1)cos(y1)sin^2((x2 - y2) / 2)}]

    """

    def _validate_data(self, X):
        # [FUNCTION DOC]
        # Behavior: checks that X has exactly 2 columns.
        # Inputs: X: 2-D array. Outputs: None.
        # Exceptions: ValueError otherwise. Side effects: none.
        if X.shape[1] != 2:
            raise ValueError("Haversine distance only valid "
                             "in 2 dimensions")

    cdef inline {{INPUT_DTYPE_t}} rdist(self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: reduced haversine: sin^2((x1[0]-x2[0])/2) + cos(x1[0]) cos(x2[0])
        #   sin^2((x1[1]-x2[1])/2). Only the first two coordinates are read; size is ignored.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: surrogate distance in [0, 1].
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t sin_0 = sin(0.5 * ((x1[0]) - (x2[0])))
        cdef float64_t sin_1 = sin(0.5 * ((x1[1]) - (x2[1])))
        return (sin_0 * sin_0 + cos(x1[0]) * cos(x2[0]) * sin_1 * sin_1)

    cdef inline {{INPUT_DTYPE_t}} dist(self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense haversine distance: 2 arcsin(sqrt(rdist)).
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return 2 * asin(sqrt(self.rdist(x1, x2, size)))

    cdef inline {{INPUT_DTYPE_t}} _rdist_to_dist(self, {{INPUT_DTYPE_t}} rdist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a reduced (rank-preserving surrogate) distance to the true
        #   distance: 2 arcsin(sqrt(rdist)).
        # Inputs: rdist: surrogate distance (input dtype).
        # Outputs: true distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return 2 * asin(sqrt(rdist))

    cdef inline {{INPUT_DTYPE_t}} _dist_to_rdist(self, {{INPUT_DTYPE_t}} dist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a true distance to the reduced (surrogate) distance: sin(dist / 2) squared.
        # Inputs: dist: true distance (input dtype).
        # Outputs: surrogate distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t tmp = sin(0.5 *  dist)
        return tmp * tmp

    def rdist_to_dist(self, rdist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of surrogate distance(s) to true distance(s):
        #   2 arcsin(sqrt(rdist)); works elementwise on scalars or numpy arrays.
        # Inputs: rdist: float or array of surrogate distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return 2 * np.arcsin(np.sqrt(rdist))

    def dist_to_rdist(self, dist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of true distance(s) to surrogate distance(s):
        #   sin(dist / 2) squared; works elementwise on scalars or numpy arrays.
        # Inputs: dist: float or array of true distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        tmp = np.sin(0.5 * dist)
        return tmp * tmp

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: haversine distance between two CSR rows: 2 arcsin(sqrt(rdist_csr)).
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return 2 * asin(sqrt(self.rdist_csr(
            x1_data,
            x1_indices,
            x2_data,
            x2_indices,
            x1_start,
            x1_end,
            x2_start,
            x2_end,
            size,
        )))

    cdef inline {{INPUT_DTYPE_t}} rdist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: reduced haversine between CSR rows. Reconstructs the two 2-D points from
        #   the stored entries (missing coordinates are 0), deciding which coordinate an entry
        #   belongs to from its column index, then applies the dense rdist formula.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: surrogate distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        # KNOWN ISSUE: the coordinate is taken as the column index modulo the row's start
        #   offset (x1_start / x2_start) when that offset is nonzero, but CSR column indices
        #   are already 0 or 1. When the offset is exactly 1, column 1 maps to coordinate 0,
        #   so the longitude overwrites the latitude and the result is wrong. The main merge
        #   loop also advances both cursors together without comparing columns (harmless
        #   only because each coordinate is assigned independently).

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t x1_0 = 0
            float64_t x1_1 = 0
            float64_t x2_0 = 0
            float64_t x2_1 = 0
            float64_t sin_0
            float64_t sin_1

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            # Find the components in the 2D vectors to work with
            x1_component = ix1 if (x1_start == 0) else ix1 % x1_start
            x2_component = ix2 if (x2_start == 0) else ix2 % x2_start

            if x1_component == 0:
                x1_0 = x1_data[i1]
            else:
                x1_1 = x1_data[i1]

            if x2_component == 0:
                x2_0 = x2_data[i2]
            else:
                x2_1 = x2_data[i2]

            i1 = i1 + 1
            i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                ix2 = x2_indices[i2]
                x2_component = ix2 if (x2_start == 0) else ix2 % x2_start
                if x2_component == 0:
                    x2_0 = x2_data[i2]
                else:
                    x2_1 = x2_data[i2]
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                ix1 = x1_indices[i1]
                x1_component = ix1 if (x1_start == 0) else ix1 % x1_start
                if x1_component == 0:
                    x1_0 = x1_data[i1]
                else:
                    x1_1 = x1_data[i1]
                i1 = i1 + 1

        sin_0 = sin(0.5 * (x1_0 - x2_0))
        sin_1 = sin(0.5 * (x1_1 - x2_1))

        return (sin_0 * sin_0 + cos(x1_0) * cos(x2_0) * sin_1 * sin_1)

#------------------------------------------------------------
# User-defined distance
#
cdef class PyFuncDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Metric wrapping a user Python callable func(x, y, **kwargs) -> float. Every distance
    # evaluation reacquires the GIL and calls into Python, so it is slow. func and kwargs are
    # kept in the base-class attributes and included in the pickled state.
    """PyFunc Distance

    A user-defined distance

    Parameters
    ----------
    func : function
        func should take two numpy arrays as input, and return a distance.
    """
    def __init__(self, func, **kwargs):
        # [FUNCTION DOC]
        # Behavior: stores the callable and its extra keyword arguments.
        # Inputs: func: callable taking two 1-D numpy arrays; kwargs: forwarded to func.
        # Outputs: none. Exceptions: none (func is not validated).
        # Side effects: mutates func, kwargs.
        self.func = func
        self.kwargs = kwargs

    # in cython < 0.26, GIL was required to be acquired during definition of
    # the function and inside the body of the function. This behaviour is not
    # allowed in cython >= 0.26 since it is a redundant GIL acquisition. The
    # only way to be back compatible is to inherit `dist` from the base class
    # without GIL and called an inline `_dist` which acquire GIL.
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: nogil entry point required by the base signature; forwards to _dist,
        #   which acquires the GIL.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: value returned by func.
        # Exceptions: propagates exceptions from _dist via the -1 error return.
        # Side effects: acquires the GIL inside _dist.
        return self._dist(x1, x2, size)

    cdef inline {{INPUT_DTYPE_t}} _dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 with gil:
        # [FUNCTION DOC]
        # HELPER: GIL-holding implementation of PyFuncDistance.dist.
        # Behavior: wraps x1 and x2 as numpy arrays (no copy, via _buffer_to_ndarray), calls
        #   func(x1arr, x2arr, **kwargs) and converts the result to the input dtype.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: func's result converted to a C float (input dtype).
        # Exceptions: any exception raised by func; a TypeError if the result is not
        #   convertible to float. Returning exactly -1 makes callers check for a pending error.
        # Side effects: acquires the GIL; runs arbitrary user code.
        # KNOWN ISSUE: see _buffer_to_ndarray: in the 32 instantiation the arrays passed to
        #   func reinterpret float32 memory as float64.
        cdef:
            object x1arr = _buffer_to_ndarray{{name_suffix}}(x1, size)
            object x2arr = _buffer_to_ndarray{{name_suffix}}(x2, size)
        d = self.func(x1arr, x2arr, **self.kwargs)
        try:
            # Cython generates code here that results in a TypeError
            # if d is the wrong type.
            return d
        except TypeError:
            raise TypeError("Custom distance function must accept two "
                            "vectors and return a float.")

{{endfor}}
