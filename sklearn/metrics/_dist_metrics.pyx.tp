#------------------------------------------------------------
# Russell-Rao Distance (boolean)
#  D(x, y) = (n - ntt) / n
cdef class RussellRaoDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Russell-Rao dissimilarity for boolean vectors (nonzero = True): (N - NTT) / N.
    r"""Russell-Rao Distance

    Russell-Rao Distance is a dissimilarity measure for boolean-valued
    vectors. All nonzero entries will be treated as True, zero entries will
    be treated as False.

        D(x, y) = (N - N_TT) / N
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Russell-Rao distance: (size - n_tt) / size.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef int tf1, tf2, n_tt = 0
        cdef intp_t j
        for j in range(size):
            tf1 = x1[j] != 0
            tf2 = x2[j] != 0
            n_tt += (tf1 and tf2)
        return (size - n_tt) * 1. / size

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Russell-Rao distance between two CSR rows: (size - n_tt) / size, where
        #   n_tt counts columns stored in both rows with both values nonzero. The merge stops
        #   as soon as one row is exhausted since remaining entries cannot increase n_tt.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            intp_t tf1, tf2, n_tt = 0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            tf1 = x1_data[i1] != 0
            tf2 = x2_data[i2] != 0

            if ix1 == ix2:
                n_tt += (tf1 and tf2)
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                i1 = i1 + 1
            else:
                i2 = i2 + 1

        # We don't need to go through all the longest
        # vector because tf1 or tf2 will be false
        # and thus n_tt won't be increased.

        return (size - n_tt) * 1. / size



