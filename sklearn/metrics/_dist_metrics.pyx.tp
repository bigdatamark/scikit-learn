        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return euclidean_dist{{name_suffix}}(x1, x2, size)

    cdef inline {{INPUT_DTYPE_t}} rdist(self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: squared Euclidean distance sum_j (x1[j]-x2[j])^2 via euclidean_rdist.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: squared distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return euclidean_rdist{{name_suffix}}(x1, x2, size)

    cdef inline {{INPUT_DTYPE_t}} _rdist_to_dist(self, {{INPUT_DTYPE_t}} rdist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a reduced (rank-preserving surrogate) distance to the true
        #   distance: square root.
        # Inputs: rdist: surrogate distance (input dtype).
        # Outputs: true distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return sqrt(rdist)

    cdef inline {{INPUT_DTYPE_t}} _dist_to_rdist(self, {{INPUT_DTYPE_t}} dist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a true distance to the reduced (surrogate) distance: square.
        # Inputs: dist: true distance (input dtype).
        # Outputs: surrogate distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return dist * dist

    def rdist_to_dist(self, rdist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of surrogate distance(s) to true distance(s):
        #   numpy square root; works elementwise on scalars or numpy arrays.
        # Inputs: rdist: float or array of surrogate distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return np.sqrt(rdist)

    def dist_to_rdist(self, dist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of true distance(s) to surrogate distance(s):
        #   square; works elementwise on scalars or numpy arrays.
        # Inputs: dist: float or array of true distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return dist ** 2

    cdef inline {{INPUT_DTYPE_t}} rdist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: squared Euclidean distance between two CSR rows: sum of squared differences, where a column present in one row only contributes the square of its value.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
