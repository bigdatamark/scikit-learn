# Manhattan Distance
#  d = sum(abs(x_i - y_i))
cdef class ManhattanDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Manhattan / city-block (L1) metric: sum of absolute differences. Sets p = 1.
    # rdist is the inherited default (equal to dist).
    r"""Manhattan/City-block Distance metric

    .. math::
       D(x, y) = \sum_i |x_i - y_i|
    """
    def __init__(self):
        # [FUNCTION DOC]
        # Behavior: constructor; sets the shared parameter p to 1 (used by tree code that
        #   inspects metric.p). Takes no metric parameters.
        # Inputs: none. Outputs: none.
        # Exceptions: none. Side effects: mutates self.p.
        self.p = 1

    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Manhattan distance: sum_j |x1[j]-x2[j]| accumulated in float64.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t d = 0
        cdef intp_t j
        for j in range(size):
            d += fabs(x1[j] - x2[j])
        return d

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Manhattan distance between two CSR rows: sum of absolute differences; unmatched columns add the absolute value of the entry.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        #   Note: the accumulator here has the input dtype (float32 in the 32 instantiation),
        #   unlike the dense kernel which accumulates in float64.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            {{INPUT_DTYPE_t}} d = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                d = d + fabs(x1_data[i1] - x2_data[i2])
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                d = d + fabs(x1_data[i1])
                i1 = i1 + 1
            else:
                d = d + fabs(x2_data[i2])
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                d = d + fabs(x2_data[i2])
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                d = d + fabs(x1_data[i1])
                i1 = i1 + 1

        return d


#------------------------------------------------------------
# Chebyshev Distance
#  d = max_i(abs(x_i - y_i))
cdef class ChebyshevDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Chebyshev / L-infinity metric: maximum absolute coordinate difference. Sets p = inf.
    # KNOWN ISSUE: the docstring example imports from the non-existent module
    #   sklearn.metrics.dist_metrics and its expected output (1.732..., 5.196...,
    #   6.928...) are Euclidean values; the Chebyshev result would be [[1, 3], [4, 0]].
    """Chebyshev/Infinity Distance

    .. math::
       D(x, y) = max_i (|x_i - y_i|)

    Examples
    --------
    >>> from sklearn.metrics.dist_metrics import DistanceMetric
    >>> dist = DistanceMetric.get_metric('chebyshev')
    >>> X = [[0, 1, 2],
    ...      [3, 4, 5]]
    >>> Y = [[-1, 0, 1],
    ...      [3, 4, 5]]
    >>> dist.pairwise(X, Y)
    array([[1.732..., 5.196...],
           [6.928..., 0....   ]])
    """
    def __init__(self):
        # [FUNCTION DOC]
        # Behavior: constructor; sets the shared parameter p to infinity (INF of this dtype) (used by tree code that
        #   inspects metric.p). Takes no metric parameters.
        # Inputs: none. Outputs: none.
        # Exceptions: none. Side effects: mutates self.p.
        self.p = INF{{name_suffix}}

    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Chebyshev distance: max_j |x1[j]-x2[j]| starting from 0 (uses fmax).
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t d = 0
        cdef intp_t j
        for j in range(size):
            d = fmax(d, fabs(x1[j] - x2[j]))
        return d


    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Chebyshev distance between two CSR rows: running maximum of absolute differences; unmatched columns use the absolute value of the entry.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t d = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                d = fmax(d, fabs(x1_data[i1] - x2_data[i2]))
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                d = fmax(d, fabs(x1_data[i1]))
                i1 = i1 + 1
            else:
                d = fmax(d, fabs(x2_data[i2]))
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                d = fmax(d, fabs(x2_data[i2]))
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                d = fmax(d, fabs(x1_data[i1]))
                i1 = i1 + 1

        return d


#------------------------------------------------------------
# Minkowski Distance
cdef class MinkowskiDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Minkowski metric of order p (0 < p < inf), optionally weighted:
    # (sum_j w_j |x_j - y_j|^p)^(1/p). p is stored in p; weights (if any) in vec with
    # length size (size == 0 means unweighted). rdist is the sum before the 1/p power.
    # For 0 < p < 1 it is not a true metric (triangle inequality fails).
    r"""Minkowski Distance

    .. math::
        D(x, y) = {||u-v||}_p

    when w is None.

    Here is the more general expanded expression for the weighted case:

    .. math::
        D(x, y) = [\sum_i w_i *|x_i - y_i|^p] ^ (1/p)

    Parameters
    ----------
    p : float
        The order of the p-norm of the difference (see above).

        .. versionchanged:: 1.4.0
            Minkowski distance allows `p` to be `0<p<1`.


    w : (N,) array-like (optional)
        The weight vector.

    Minkowski Distance requires p > 0 and finite.
    When :math:`p \in (0,1)`, it isn't a true metric but is permissible when
    the triangular inequality isn't necessary.
    For p = infinity, use ChebyshevDistance.
    Note that for p=1, ManhattanDistance is more efficient, and for
    p=2, EuclideanDistance is more efficient.

    """
    def __init__(self, p, w=None):
        # [FUNCTION DOC]
        # Behavior: validates p and optional weights and stores them.
        # Inputs: p: positive finite number; w: optional 1-D array-like of non-negative
        #   weights (converted to float64 via check_array).
        # Outputs: none.
        # Exceptions: ValueError if p <= 0, if p is infinite, or if w has negative entries;
        #   check_array errors for invalid w.
        # Side effects: sets p, vec (empty array when w is None) and size (0 when unweighted).
        if p <= 0:
            raise ValueError("p must be greater than 0")
        elif np.isinf(p):
            raise ValueError("MinkowskiDistance requires finite p. "
                             "For p=inf, use ChebyshevDistance.")

        self.p = p
        if w is not None:
            w_array = check_array(
                w, ensure_2d=False, dtype=np.float64, input_name="w"
            )
            if (w_array < 0).any():
                raise ValueError("w cannot contain negative weights")
            self.vec = w_array
            self.size = self.vec.shape[0]
        else:
            self.vec = np.asarray([], dtype=np.float64)
            self.size = 0

    def _validate_data(self, X):
        # [FUNCTION DOC]
        # Behavior: when weights are set, checks that X has len(w) columns.
        # Inputs: X: 2-D array. Outputs: None.
        # Exceptions: ValueError on mismatch. Side effects: none.
        if self.size > 0 and X.shape[1] != self.size:
            raise ValueError("MinkowskiDistance: the size of w must match "
                             f"the number of features ({X.shape[1]}). "
                             f"Currently len(w)={self.size}.")

    cdef inline {{INPUT_DTYPE_t}} rdist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense reduced Minkowski distance: sum_j w[j] * |x1[j]-x2[j]|^p, or without w when size == 0 (no 1/p root).
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t d=0
        cdef intp_t j
        cdef bint has_w = self.size > 0
        if has_w:
            for j in range(size):
                d += (self.vec[j] * pow(fabs(x1[j] - x2[j]), self.p))
        else:
            for j in range(size):
                d += (pow(fabs(x1[j] - x2[j]), self.p))
        return d

    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Minkowski distance: rdist raised to the power 1/p.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return pow(self.rdist(x1, x2, size), 1. / self.p)

    cdef inline {{INPUT_DTYPE_t}} _rdist_to_dist(self, {{INPUT_DTYPE_t}} rdist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a reduced (rank-preserving surrogate) distance to the true
        #   distance: rdist to the power 1/p.
        # Inputs: rdist: surrogate distance (input dtype).
        # Outputs: true distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return pow(rdist, 1. / self.p)

    cdef inline {{INPUT_DTYPE_t}} _dist_to_rdist(self, {{INPUT_DTYPE_t}} dist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a true distance to the reduced (surrogate) distance: dist to the power p.
        # Inputs: dist: true distance (input dtype).
        # Outputs: surrogate distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return pow(dist, self.p)

    def rdist_to_dist(self, rdist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of surrogate distance(s) to true distance(s):
        #   rdist ** (1/p); works elementwise on scalars or numpy arrays.
        # Inputs: rdist: float or array of surrogate distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return rdist ** (1. / self.p)

    def dist_to_rdist(self, dist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of true distance(s) to surrogate distance(s):
        #   dist ** p; works elementwise on scalars or numpy arrays.
        # Inputs: dist: float or array of true distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return dist ** self.p

    cdef inline {{INPUT_DTYPE_t}} rdist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: reduced Minkowski distance between two CSR rows: sum of (optionally weighted by w[column]) |difference|^p; unmatched columns contribute (w[column] *) |value|^p. Two code paths: weighted and unweighted.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t d = 0.0
            bint has_w = self.size > 0

        if has_w:
            while i1 < x1_end and i2 < x2_end:
                ix1 = x1_indices[i1]
                ix2 = x2_indices[i2]

                if ix1 == ix2:
                    d = d + (self.vec[ix1] * pow(fabs(
                        x1_data[i1] - x2_data[i2]
                    ), self.p))
                    i1 = i1 + 1
                    i2 = i2 + 1
                elif ix1 < ix2:
                    d = d + (self.vec[ix1] * pow(fabs(x1_data[i1]), self.p))
                    i1 = i1 + 1
                else:
                    d = d + (self.vec[ix2] * pow(fabs(x2_data[i2]), self.p))
                    i2 = i2 + 1

            if i1 == x1_end:
                while i2 < x2_end:
                    ix2 = x2_indices[i2]
                    d = d + (self.vec[ix2] * pow(fabs(x2_data[i2]), self.p))
                    i2 = i2 + 1
            else:
                while i1 < x1_end:
                    ix1 = x1_indices[i1]
                    d = d + (self.vec[ix1] * pow(fabs(x1_data[i1]), self.p))
                    i1 = i1 + 1

            return d
        else:
            while i1 < x1_end and i2 < x2_end:
                ix1 = x1_indices[i1]
                ix2 = x2_indices[i2]

                if ix1 == ix2:
                    d = d + (pow(fabs(
                        x1_data[i1] - x2_data[i2]
                    ), self.p))
                    i1 = i1 + 1
                    i2 = i2 + 1
                elif ix1 < ix2:
                    d = d + (pow(fabs(x1_data[i1]), self.p))
                    i1 = i1 + 1
                else:
                    d = d + (pow(fabs(x2_data[i2]), self.p))
                    i2 = i2 + 1

            if i1 == x1_end:
                while i2 < x2_end:
                    d = d + (pow(fabs(x2_data[i2]), self.p))
                    i2 = i2 + 1
            else:
                while i1 < x1_end:
                    d = d + (pow(fabs(x1_data[i1]), self.p))
                    i1 = i1 + 1

            return d

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Minkowski distance between two CSR rows: rdist_csr raised to 1/p.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return pow(
            self.rdist_csr(
                x1_data,
                x1_indices,
                x2_data,
                x2_indices,
                x1_start,
                x1_end,
                x2_start,
                x2_end,
                size,
            ),
            1 / self.p
        )

#------------------------------------------------------------
# Mahalanobis Distance
#  d = sqrt( (x - y)^T V^-1 (x - y) )
cdef class MahalanobisDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Mahalanobis metric: sqrt((x - y)^T VI (x - y)) with VI the inverse covariance, stored
    # in mat (size x size). Has an extra float64 scratch buffer of length size that holds
    # the coordinate difference during each call. rdist is the quadratic form without sqrt.
    # KNOWN ISSUE: the shared scratch buffer makes rdist/rdist_csr not thread-safe; calling
    #   the same instance concurrently from several threads (e.g. OpenMP loops in
    #   _pairwise_distances_reduction) races on buffer and can give wrong distances.
    """Mahalanobis Distance

    .. math::
       D(x, y) = \sqrt{ (x - y)^T V^{-1} (x - y) }

    Parameters
    ----------
    V : array-like
        Symmetric positive-definite covariance matrix.
        The inverse of this matrix will be explicitly computed.
    VI : array-like
        optionally specify the inverse directly.  If VI is passed,
        then V is not referenced.
    """
    cdef float64_t[::1] buffer

    def __init__(self, V=None, VI=None):
        # [FUNCTION DOC]
        # Behavior: uses VI if given, otherwise computes it as the inverse of V with
        #   numpy.linalg.inv; checks it is square; stores it in mat (float64, C order), sets
        #   size and allocates the zeroed scratch buffer.
        # Inputs: V: covariance matrix (array, used only if VI is None); VI: inverse covariance.
        # Outputs: none.
        # Exceptions: ValueError if both are None or the matrix is not square; LinAlgError if
        #   V is singular; AttributeError if VI is a plain list (uses .ndim without conversion).
        # Side effects: allocates buffer, mutates mat and size.
        if VI is None:
            if V is None:
                raise ValueError("Must provide either V or VI "
                                 "for Mahalanobis distance")
            VI = np.linalg.inv(V)
        if VI.ndim != 2 or VI.shape[0] != VI.shape[1]:
            raise ValueError("V/VI must be square")

        self.mat = np.asarray(VI, dtype=np.float64, order='C')

        self.size = self.mat.shape[0]

        # We need to create a buffer to store the vectors' coordinates' differences
        self.buffer = np.zeros(self.size, dtype=np.float64)

    def __setstate__(self, state):
        # [FUNCTION DOC]
        # Behavior: restores base state, then resets size from mat and reallocates the scratch
        #   buffer (the base __setstate__ sets size from vec, which is wrong for Mahalanobis).
        # Inputs: state tuple from __getstate__. Outputs: none.
        # Exceptions: as base __setstate__. Side effects: allocation, mutates self.
        super().__setstate__(state)
        self.size = self.mat.shape[0]
        self.buffer = np.zeros(self.size, dtype=np.float64)

    def _validate_data(self, X):
        # [FUNCTION DOC]
        # Behavior: checks that X has size (= VI dimension) columns.
        # Inputs: X: 2-D array. Outputs: None.
        # Exceptions: ValueError on mismatch. Side effects: none.
        if X.shape[1] != self.size:
            raise ValueError('Mahalanobis dist: size of V does not match')

    cdef inline {{INPUT_DTYPE_t}} rdist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: reduced Mahalanobis distance: writes x1 - x2 into the scratch buffer,
        #   then computes the quadratic form sum_i buffer[i] * sum_j mat[i,j] * buffer[j]
        #   (O(size^2)).
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil).
        # Side effects: overwrites self.buffer (not thread-safe); runs without the GIL.
        cdef float64_t tmp, d = 0
        cdef intp_t i, j

        # compute (x1 - x2).T * VI * (x1 - x2)
        for i in range(size):
            self.buffer[i] = x1[i] - x2[i]

        for i in range(size):
            tmp = 0
            for j in range(size):
                tmp += self.mat[i, j] * self.buffer[j]
            d += tmp * self.buffer[i]
        return d

    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Mahalanobis distance: square root of rdist (shares the scratch buffer side effect).
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return sqrt(self.rdist(x1, x2, size))

    cdef inline {{INPUT_DTYPE_t}} _rdist_to_dist(self, {{INPUT_DTYPE_t}} rdist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a reduced (rank-preserving surrogate) distance to the true
        #   distance: square root.
        # Inputs: rdist: surrogate distance (input dtype).
        # Outputs: true distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return sqrt(rdist)

    cdef inline {{INPUT_DTYPE_t}} _dist_to_rdist(self, {{INPUT_DTYPE_t}} dist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a true distance to the reduced (surrogate) distance: square.
        # Inputs: dist: true distance (input dtype).
        # Outputs: surrogate distance.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return dist * dist

    def rdist_to_dist(self, rdist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of surrogate distance(s) to true distance(s):
        #   numpy square root; works elementwise on scalars or numpy arrays.
        # Inputs: rdist: float or array of surrogate distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return np.sqrt(rdist)

    def dist_to_rdist(self, dist):
        # [FUNCTION DOC]
        # Behavior: Python-visible conversion of true distance(s) to surrogate distance(s):
        #   square; works elementwise on scalars or numpy arrays.
        # Inputs: dist: float or array of true distances.
        # Outputs: same shape as input.
        # Exceptions: none explicit. Side effects: none.
        return dist ** 2

    cdef inline {{INPUT_DTYPE_t}} rdist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: reduced Mahalanobis distance between CSR rows: scatters the difference
        #   x1 - x2 into the scratch buffer by column (matched columns: difference; columns only
        #   in x1: +value; only in x2: -value), then computes the full quadratic form over
        #   all size x size entries of mat.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: surrogate (squared) distance.
        # Exceptions: none raised (nogil).
        # Side effects: overwrites parts of self.buffer (not thread-safe); runs without the GIL.
        # KNOWN ISSUE: the buffer is never reset to zero before scattering, so columns absent
        #   from both rows keep stale differences from a previous call (dense or CSR) and
        #   corrupt the result whenever the rows are truly sparse.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t tmp, d = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                self.buffer[ix1] = x1_data[i1] - x2_data[i2]
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                self.buffer[ix1] = x1_data[i1]
                i1 = i1 + 1
            else:
                self.buffer[ix2] = - x2_data[i2]
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                ix2 = x2_indices[i2]
                self.buffer[ix2] = - x2_data[i2]
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                ix1 = x1_indices[i1]
                self.buffer[ix1] = x1_data[i1]
                i1 = i1 + 1

        for i in range(size):
            tmp = 0
            for j in range(size):
                tmp += self.mat[i, j] * self.buffer[j]
            d += tmp * self.buffer[i]

        return d

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Mahalanobis distance between two CSR rows: square root of rdist_csr (inherits its buffer issues).
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return sqrt(
            self.rdist_csr(
            x1_data,
            x1_indices,
            x2_data,
            x2_indices,
            x1_start,
            x1_end,
            x2_start,
            x2_end,
            size,
        ))

#------------------------------------------------------------
# Hamming Distance
#  d = N_unequal(x, y) / N_tot
cdef class HammingDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Hamming metric: fraction of coordinates whose values differ (exact comparison,
    # valid for real values too). No parameters; rdist equals dist.
    r"""Hamming Distance

    Hamming distance is meant for discrete-valued vectors, though it is
    a valid metric for real-valued vectors.

    .. math::
       D(x, y) = \frac{1}{N} \sum_i \delta_{x_i, y_i}
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Hamming distance: count of j with x1[j] != x2[j] divided by size.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef int n_unequal = 0
        cdef intp_t j
        for j in range(size):
            if x1[j] != x2[j]:
                n_unequal += 1
        return float(n_unequal) / size


    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Hamming distance between two CSR rows: number of columns whose values differ (an unmatched nonzero entry counts as a difference) divided by size.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t d = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                d += (x1_data[i1] != x2_data[i2])
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                d += (x1_data[i1] != 0)
                i1 = i1 + 1
            else:
                d += (x2_data[i2] != 0)
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                d += (x2_data[i2] != 0)
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                d += (x1_data[i1] != 0)
                i1 = i1 + 1

        d /= size

        return d


#------------------------------------------------------------
# Canberra Distance
#  D(x, y) = sum[ abs(x_i - y_i) / (abs(x_i) + abs(y_i)) ]
cdef class CanberraDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Canberra metric: sum_j |x_j - y_j| / (|x_j| + |y_j|), skipping terms where both are 0.
    r"""Canberra Distance

    Canberra distance is meant for discrete-valued vectors, though it is
    a valid metric for real-valued vectors.

    .. math::
       D(x, y) = \sum_i \frac{|x_i - y_i|}{|x_i| + |y_i|}
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Canberra distance: sum of |x1[j]-x2[j]| / (|x1[j]|+|x2[j]|) over j with a positive denominator.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t denom, d = 0
        cdef intp_t j
        for j in range(size):
            denom = fabs(x1[j]) + fabs(x2[j])
            if denom > 0:
                d += fabs(x1[j] - x2[j]) / denom
        return d

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Canberra distance between two CSR rows: matched columns add |a-b|/(|a|+|b|); each unmatched column adds 1 (the value of the term when the other entry is zero).
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # KNOWN ISSUE: not robust to explicit zeros despite the base-class requirement: an
        #   explicit zero matched with a zero gives 0/0 = NaN, and an unmatched explicit zero adds
        #   1 instead of 0 (the dense kernel skips both cases).
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t d = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                d += (
                        fabs(x1_data[i1] - x2_data[i2]) /
                        (fabs(x1_data[i1]) + fabs(x2_data[i2]))
                )
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                d += 1.
                i1 = i1 + 1
            else:
                d += 1.
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                d += 1.
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                d += 1.
                i1 = i1 + 1

        return d

#------------------------------------------------------------
# Bray-Curtis Distance
#  D(x, y) = sum[abs(x_i - y_i)] / sum[abs(x_i) + abs(y_i)]
cdef class BrayCurtisDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Bray-Curtis metric: sum_j |x_j - y_j| / sum_j (|x_j| + |y_j|).
    r"""Bray-Curtis Distance

    Bray-Curtis distance is meant for discrete-valued vectors, though it is
    a valid metric for real-valued vectors.

    .. math::
       D(x, y) = \frac{\sum_i |x_i - y_i|}{\sum_i(|x_i| + |y_i|)}
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Bray-Curtis distance: sum |x1-x2| / sum (|x1|+|x2|), returning 0.0 when the denominator is 0.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t num = 0, denom = 0
        cdef intp_t j
        for j in range(size):
            num += fabs(x1[j] - x2[j])
            denom += fabs(x1[j]) + fabs(x2[j])
        if denom > 0:
            return num / denom
        else:
            return 0.0

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Bray-Curtis distance between two CSR rows: numerator sum of |difference| and denominator sum of |a|+|b|; unmatched columns add |value| to both.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        # KNOWN ISSUE: the tail loops use the wrong array: after x1 is exhausted the loop over
        #   the remaining x2 entries adds |x1_data[i1]| (an out-of-range position, i1 == x1_end)
        #   instead of |x2_data[i2]|, and the symmetric loop adds |x2_data[i2]| instead of
        #   |x1_data[i1]|. Results are wrong (and memory is read out of range). Also, unlike the
        #   dense kernel, two all-zero rows give 0/0 = NaN instead of 0.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            float64_t num = 0.0
            float64_t denom = 0.0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                num += fabs(x1_data[i1] - x2_data[i2])
                denom += fabs(x1_data[i1]) + fabs(x2_data[i2])
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                num += fabs(x1_data[i1])
                denom += fabs(x1_data[i1])
                i1 = i1 + 1
            else:
                num += fabs(x2_data[i2])
                denom += fabs(x2_data[i2])
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                num += fabs(x1_data[i1])
                denom += fabs(x1_data[i1])
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                num += fabs(x2_data[i2])
                denom += fabs(x2_data[i2])
                i1 = i1 + 1

        return num / denom

#------------------------------------------------------------
# Jaccard Distance (boolean)
#  D(x, y) = N_unequal(x, y) / N_nonzero(x, y)
cdef class JaccardDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Jaccard dissimilarity for boolean vectors (nonzero = True): NNEQ / NNZ, defined as 0 when both vectors are all False.
    r"""Jaccard Distance

    Jaccard Distance is a dissimilarity measure for boolean-valued
    vectors. All nonzero entries will be treated as True, zero entries will
    be treated as False.

        D(x, y) = (N_TF + N_FT) / (N_TT + N_TF + N_FT)
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Jaccard distance: (nnz - n_tt) / nnz, where nnz counts columns where either is True and n_tt where both are; 0 if nnz == 0.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef int tf1, tf2, n_eq = 0, nnz = 0
        cdef intp_t j
        for j in range(size):
            tf1 = x1[j] != 0
            tf2 = x2[j] != 0
            nnz += (tf1 or tf2)
            n_eq += (tf1 and tf2)
        # Based on https://github.com/scipy/scipy/pull/7373
        # When comparing two all-zero vectors, scipy>=1.2.0 jaccard metric
        # was changed to return 0, instead of nan.
        if nnz == 0:
            return 0
        return (nnz - n_eq) * 1.0 / nnz

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Jaccard distance between two CSR rows: same counts from stored entries (unmatched entries add to nnz if nonzero); 0 if nnz == 0.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            intp_t tf1, tf2, n_tt = 0, nnz = 0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            tf1 = x1_data[i1] != 0
            tf2 = x2_data[i2] != 0

            if ix1 == ix2:
                nnz += (tf1 or tf2)
                n_tt += (tf1 and tf2)
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                nnz += tf1
                i1 = i1 + 1
            else:
                nnz += tf2
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                tf2 = x2_data[i2] != 0
                nnz += tf2
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                tf1 = x1_data[i1] != 0
                nnz += tf1
                i1 = i1 + 1

        # Based on https://github.com/scipy/scipy/pull/7373
        # When comparing two all-zero vectors, scipy>=1.2.0 jaccard metric
        # was changed to return 0, instead of nan.
        if nnz == 0:
            return 0
        return (nnz - n_tt) * 1.0 / nnz

#------------------------------------------------------------
# Matching Distance (boolean)
#  D(x, y) = n_neq / n
cdef class MatchingDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Matching dissimilarity for boolean vectors (nonzero = True): NNEQ / N (deprecated in SciPy; same as Hamming on booleans).
    r"""Matching Distance

    Matching Distance is a dissimilarity measure for boolean-valued
    vectors. All nonzero entries will be treated as True, zero entries will
    be treated as False.

        D(x, y) = (N_TF + N_FT) / N
    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Matching distance: number of columns whose truth values differ divided by size.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef int tf1, tf2, n_neq = 0
        cdef intp_t j
        for j in range(size):
            tf1 = x1[j] != 0
            tf2 = x2[j] != 0
            n_neq += (tf1 != tf2)
        return n_neq * 1. / size

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Matching distance between two CSR rows: number of columns whose truth values differ (unmatched nonzero entries count) divided by size.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
            intp_t i2 = x2_start

            intp_t tf1, tf2, n_neq = 0

        while i1 < x1_end and i2 < x2_end:
            ix1 = x1_indices[i1]
            ix2 = x2_indices[i2]

            if ix1 == ix2:
                tf1 = x1_data[i1] != 0
                tf2 = x2_data[i2] != 0
                n_neq += (tf1 != tf2)
                i1 = i1 + 1
                i2 = i2 + 1
            elif ix1 < ix2:
                n_neq += (x1_data[i1] != 0)
                i1 = i1 + 1
            else:
                n_neq += (x2_data[i2] != 0)
                i2 = i2 + 1

        if i1 == x1_end:
            while i2 < x2_end:
                n_neq += (x2_data[i2] != 0)
                i2 = i2 + 1
        else:
            while i1 < x1_end:
                n_neq += (x1_data[i1] != 0)
                i1 = i1 + 1

        return n_neq * 1.0 / size

#------------------------------------------------------------
# Dice Distance (boolean)
#  D(x, y) = n_neq / (2 * ntt + n_neq)
cdef class DiceDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Dice dissimilarity for boolean vectors (nonzero = True): NNEQ / (2 * NTT + NNEQ).
    r"""Dice Distance

    Dice Distance is a dissimilarity measure for boolean-valued
    vectors. All nonzero entries will be treated as True, zero entries will
    be treated as False.

        D(x, y) = (N_TF + N_FT) / (2 * N_TT + N_TF + N_FT)

    """
    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense Dice distance: n_neq / (2 n_tt + n_neq); two all-False vectors give 0/0 = NaN.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef int tf1, tf2, n_neq = 0, n_tt = 0
        cdef intp_t j
        for j in range(size):
            tf1 = x1[j] != 0
            tf2 = x2[j] != 0
            n_tt += (tf1 and tf2)
            n_neq += (tf1 != tf2)
        return n_neq / (2.0 * n_tt + n_neq)

    cdef inline {{INPUT_DTYPE_t}} dist_csr(
        self,
        const {{INPUT_DTYPE_t}}* x1_data,
        const int32_t* x1_indices,
        const {{INPUT_DTYPE_t}}* x2_data,
        const int32_t* x2_indices,
        const int32_t x1_start,
        const int32_t x1_end,
        const int32_t x2_start,
        const int32_t x2_end,
        const intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: Dice distance between two CSR rows: n_neq / (2 n_tt + n_neq) from stored entries; NaN for two all-False rows.
        #   Walks both sorted index ranges simultaneously (merge step): equal column -> uses both
        #   values; column only in one vector -> the other value is implicitly zero; once one
        #   range is exhausted the rest of the other range is processed.
        #   Any nonzero value counts as True, zero as False. Counts are integers.
        # Inputs: x1_data/x1_indices and x2_data/x2_indices: CSR data and int32 column-index
        #   arrays; the vectors are the entries in positions [x1_start, x1_end) and
        #   [x2_start, x2_end). Column indices within each range must be sorted increasingly
        #   (a dense row may be passed with indices 0..size-1). size: number of features.
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.

        cdef:
            intp_t ix1, ix2
            intp_t i1 = x1_start
