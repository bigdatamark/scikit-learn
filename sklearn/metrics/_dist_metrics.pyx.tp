# SEuclidean Distance
#  d = sqrt(sum((x_i - y_i2)^2 / v_i))
cdef class SEuclideanDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Standardized Euclidean metric: sqrt(sum_j (x_j - y_j)^2 / V_j). V (per-feature
    # variances) is stored in vec and its length in size. rdist omits the square root.
    r"""Standardized Euclidean Distance metric

    .. math::
       D(x, y) = \sqrt{ \sum_i \frac{ (x_i - y_i) ^ 2}{V_i} }
    """
    def __init__(self, V):
        # [FUNCTION DOC]
        # Behavior: stores V as a float64 array in vec, its length in size, and sets p = 2.
        # Inputs: V: 1-D array-like of positive per-feature variances (positivity unchecked).
        # Outputs: none. Exceptions: numpy conversion errors.
        # Side effects: mutates vec, size, p.
        self.vec = np.asarray(V, dtype=np.float64)
        self.size = self.vec.shape[0]
        self.p = 2

    def _validate_data(self, X):
        # [FUNCTION DOC]
        # Behavior: checks that X has exactly size (len(V)) columns.
        # Inputs: X: 2-D array. Outputs: None.
        # Exceptions: ValueError if the column count differs. Side effects: none.
        if X.shape[1] != self.size:
            raise ValueError('SEuclidean dist: size of V does not match')

    cdef inline {{INPUT_DTYPE_t}} rdist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense reduced standardized Euclidean distance: sum_j (x1[j]-x2[j])^2 / V[j] (no square root).
        #   Division by a zero variance yields inf/NaN.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        cdef float64_t tmp, d=0
        cdef intp_t j
        for j in range(size):
            tmp = x1[j] - x2[j]
            d += (tmp * tmp / self.vec[j])
        return d

    cdef inline {{INPUT_DTYPE_t}} dist(
        self,
        const {{INPUT_DTYPE_t}}* x1,
        const {{INPUT_DTYPE_t}}* x2,
        intp_t size,
    ) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: dense standardized Euclidean distance: square root of rdist.
        # Inputs: x1, x2: pointers to two contiguous vectors of length size (input dtype).
        # Outputs: the distance, cast to the input dtype.
        # Exceptions: none raised (nogil); -1 is the error sentinel declared for the signature.
        # Side effects: none; runs without the GIL.
        return sqrt(self.rdist(x1, x2, size))

    cdef inline {{INPUT_DTYPE_t}} _rdist_to_dist(self, {{INPUT_DTYPE_t}} rdist) except -1 nogil:
        # [FUNCTION DOC]
        # Behavior: converts a reduced (rank-preserving surrogate) distance to the true
