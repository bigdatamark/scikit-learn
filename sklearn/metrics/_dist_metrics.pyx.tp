# Euclidean Distance
#  d = sqrt(sum(x_i^2 - y_i^2))
cdef class EuclideanDistance{{name_suffix}}(DistanceMetric{{name_suffix}}):
    # [CLASS DOC]
    # Euclidean (L2) metric: sqrt of the sum of squared coordinate differences. rdist is
    # the squared distance. Sets p = 2. No parameters.
