# [MODULE DOC]
# Tempita template generating _seq_dataset.pxd: declarations of
# SequentialDataset and its ArrayDataset (dense C-contiguous X) and CSRDataset
# (sparse CSR X) subclasses, instantiated once per dtype suffix 64 (float64)
# and 32 (float32). They provide nogil sequential or random row access, used by
# SGD, SAG and other stochastic solvers. Implementations in _seq_dataset.pyx.tp.
{{py:

"""
Dataset abstractions for sequential data access.

Template file for easily generate fused types consistent code using Tempita
(https://github.com/cython/cython/blob/master/Cython/Tempita/_tempita.py).

Generated file: _seq_dataset.pxd

Each class is duplicated for all dtypes (float and double). The keywords
between double braces are substituted during the build.
"""

# name_suffix, c_type
dtypes = [('64', 'float64_t'),
          ('32', 'float32_t')]

}}
"""Dataset abstractions for sequential data access."""

from sklearn.utils._typedefs cimport float32_t, float64_t, intp_t, uint32_t

# SequentialDataset and its two concrete subclasses are (optionally randomized)
# iterators over the rows of a matrix X and corresponding target values y.

{{for name_suffix, c_type in dtypes}}

#------------------------------------------------------------------------------

cdef class SequentialDataset{{name_suffix}}:
    # [CLASS DOC]
    # Template (instantiated per dtype suffix): base dataset holding a permutation
    # index of sample ids, the current position, n_samples and an RNG seed.
    cdef int current_index
    cdef int[::1] index
    cdef int *index_data_ptr
    cdef Py_ssize_t n_samples
    cdef uint32_t seed

    cdef void shuffle(self, uint32_t seed) noexcept nogil
    # [FUNCTION DOC]
    # Shuffle the sample index in place with a Fisher-Yates pass seeded by seed.
    cdef int _get_next_index(self) noexcept nogil
    # [FUNCTION DOC]
    # Advance the current position cyclically and return it.
    cdef int _get_random_index(self) noexcept nogil
    # [FUNCTION DOC]
    # Pick a uniformly random position, store it as current and return it.

    cdef void _sample(self, {{c_type}} **x_data_ptr, int **x_ind_ptr,
                      int *nnz, {{c_type}} *y, {{c_type}} *sample_weight,
                      int current_index) noexcept nogil
    # [FUNCTION DOC]
    # Abstract: fetch the row at a given position into the output pointers.
    cdef void next(self, {{c_type}} **x_data_ptr, int **x_ind_ptr,
                   int *nnz, {{c_type}} *y, {{c_type}} *sample_weight) noexcept nogil
    # [FUNCTION DOC]
    # Fetch the next row in (possibly shuffled) order into the output pointers.
    cdef int random(self, {{c_type}} **x_data_ptr, int **x_ind_ptr,
                    int *nnz, {{c_type}} *y, {{c_type}} *sample_weight) noexcept nogil
    # [FUNCTION DOC]
    # Fetch a uniformly random row (with replacement) into the output pointers
    # and return its position in the index array (not the dataset row id).


cdef class ArrayDataset{{name_suffix}}(SequentialDataset{{name_suffix}}):
    # [CLASS DOC]
    # Template (instantiated per dtype suffix): dataset over a dense C-contiguous
    # X with targets Y, sample weights and a shared feature-index array 0..n-1.
    cdef const {{c_type}}[:, ::1] X
    cdef const {{c_type}}[::1] Y
    cdef const {{c_type}}[::1] sample_weights
    cdef Py_ssize_t n_features
    cdef intp_t X_stride
    cdef {{c_type}} *X_data_ptr
    cdef {{c_type}} *Y_data_ptr
    cdef const int[::1] feature_indices
    cdef int *feature_indices_ptr
    cdef {{c_type}} *sample_weight_data


cdef class CSRDataset{{name_suffix}}(SequentialDataset{{name_suffix}}):
    # [CLASS DOC]
    # Template (instantiated per dtype suffix): dataset over a CSR matrix given by
    # data, indptr and indices arrays, with targets and sample weights.
    cdef const {{c_type}}[::1] X_data
    cdef const int[::1] X_indptr
    cdef const int[::1] X_indices
    cdef const {{c_type}}[::1] Y
    cdef const {{c_type}}[::1] sample_weights
    cdef {{c_type}} *X_data_ptr
    cdef int *X_indptr_ptr
    cdef int *X_indices_ptr
    cdef {{c_type}} *Y_data_ptr
    cdef {{c_type}} *sample_weight_data

{{endfor}}
